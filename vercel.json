{
  "version": 2,
  "routes": [
    {
      "src": "/healthz",
      "dest": "/api/index.py"
    },
    {
      "src": "/readyz",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/v1/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "handle": "filesystem"
    }
  ]
}
