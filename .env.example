# ExplorerTN Environment Settings Template
PROJECT_NAME="ExplorerTN Backend Core"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database & Cache
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/explorer_tn"
REDIS_URL="redis://localhost:6379/0"

# AI Features API Key Configuration
AI_API_KEY="osk_live_..."
OPENROUTER_API_KEY="osk_live_..."
GEMINI_API_KEY="osk_live_..."
VITE_AI_API_KEY="osk_live_..."

# OpenSERP Web-Grounding API Configuration
OPENSERP_API_KEY="openserp_live_..."
OPENSERP_BASE_URL="https://api.openserp.com/v1/search"

# Security & Authentication
SUPABASE_JWT_SECRET="super-secret-jwt-key-explorer-tn-production"
ALGORITHM="HS256"
