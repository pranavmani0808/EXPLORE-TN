# Supabase Primary Database Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# SERVER-ONLY. Required for /api/v1/user/sync writes, admin verification and
# place creation. Never prefix with VITE_ — that would ship it to the browser.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Google Maps & Geospatial Tile Engine
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Server-side crypto keys used by the CAIN security layer (no hardcoded
# fallbacks — the app fails closed without them).
EXPLORETN_ADMIN_SIGNING_KEY=generate_a_long_random_secret_here
EXPLORETN_SECURITY_SECRET=generate_a_64_char_hex_key_here

# Rate Limiter (Optional Upstash Redis - falls back to high-speed in-memory rate limiting if unset)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# API Base URL (Defaults to current origin in production)
VITE_API_URL=https://explore-tn-ochre.vercel.app
