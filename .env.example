# ExplorerTN Environment Settings Template
# Copy to `.env` and fill real values locally. Never commit live keys.

PROJECT_NAME="ExplorerTN Backend Core"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database & Cache
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/explorer_tn"
REDIS_URL="redis://localhost:6379/0"

# AI Features — leave blank to run planner without LLM providers
AI_API_KEY=""
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
VITE_AI_API_KEY=""

# OpenSERP Web-Grounding
OPENSERP_API_KEY=""
OPENSERP_BASE_URL="https://api.openserp.com/v1/search"

# Real Road Routing Engine
ROUTING_PROVIDER="osrm"
ROUTING_BASE_URL="http://router.project-osrm.org"

# Security & Authentication
SUPABASE_JWT_SECRET=""
ALGORITHM="HS256"

# Frontend
VITE_API_URL=""
VITE_GOOGLE_MAPS_API_KEY=""
